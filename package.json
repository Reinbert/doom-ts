{
  "name": "@reinbert/doom-ts",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeScript port of Doom",
  "keywords": [
    "doom",
    "game-engine",
    "webgl",
    "threejs",
    "typescript"
  ],
  "license": "GPL-3.0",
  "author": "Reinbert (https://github.com/reinbert)",
  "contributors": [
    "Thomas Chandelle (https://gitlab.com/tchandelle)"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./public/*": "./dist/public/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "^3.0.1",
    "lil-gui": "^0.19.1",
    "smplr": "^0.12.2",
    "stats.js": "^0.17.0",
    "three": "^0.163.0"
  },
  "devDependencies": {
    "@types/stats.js": "^0.17.3",
    "@types/three": "^0.163.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-dts": "^5.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
